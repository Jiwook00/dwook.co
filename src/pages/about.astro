---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE, SOCIALS } from "@consts";

const ABOUT = {
  TITLE: "About",
  DESCRIPTION: "김지욱 — 5년 차 백엔드·인프라 개발자.",
};
---

<Layout title={ABOUT.TITLE} description={ABOUT.DESCRIPTION}>
  <Container>
    <aside data-pagefind-ignore>
      <div class="space-y-16">
        <section class="animate space-y-4">
          <h1 class="font-semibold text-black dark:text-white">
            안녕하세요, 김지욱입니다.
          </h1>
          <article class="space-y-4">
            <p>
              5년 차 백엔드·인프라 개발자입니다. AWS 인프라 위에서 NestJS로
              서버를 짓고, 이미 돌아가고 있는 시스템을 다시 손보는 일을 주로
              해왔습니다. Firebase에서 PostgreSQL로 옮기는 마이그레이션, Node.js
              컴파일 서버의 Go 전환, 두 서비스가 뒤엉킨 AWS 계정의 분리 같은
              일들입니다.
            </p>
            <p>
              문제를 분석하는 단계부터 실제로 고치는 단계까지 직접 끌고 가는
              편입니다. 최근에는 AI 도구를 개발 전반에 붙여 반복 작업을
              자동화하고, 혼자 다룰 수 있는 범위를 넓히는 데 관심이 많습니다.
            </p>
          </article>
        </section>

        <section class="animate space-y-4">
          <h2 class="font-semibold text-black dark:text-white">
            지금 하고 있는 것
          </h2>
          <article class="space-y-4">
            <p>
              2026년, 사이드 프로젝트들을 만들어가며
              <strong>1인 개발자로 지속 가능한 삶</strong>을 세우는 데 집중하고
              있습니다. 올해는 일단 만들고, 배우고, 쌓는 시기라고 생각합니다.
              무엇을 만들고 있는지는 <Link href="/projects">Projects</Link> 페이지에서
              볼 수 있습니다.
            </p>
            <p>
              미니멀하고 지속 가능한 시스템을 선호합니다. 과한 설계보다는, 오래
              들여다봐도 부담스럽지 않은 결과물을 좋아합니다.
            </p>
          </article>
        </section>

        <section class="animate space-y-4">
          <h2 class="font-semibold text-black dark:text-white">기술 스택</h2>
          <ul class="list-disc space-y-1 pl-5">
            <li>주력 — TypeScript/NestJS, PostgreSQL, AWS</li>
            <li>
              인프라·운영 — Docker, GitHub Actions, Prometheus · Loki · Grafana
            </li>
            <li>실무 적용 경험 — Go/Gin</li>
          </ul>
        </section>

        <section class="animate space-y-4">
          <h2 class="font-semibold text-black dark:text-white">
            Let's Connect
          </h2>
          <ul class="not-prose flex flex-wrap gap-2">
            {
              SOCIALS.map((SOCIAL) => (
                <li class="flex gap-x-2 text-nowrap">
                  <Link
                    href={SOCIAL.HREF}
                    external
                    aria-label={`${SITE.TITLE} on ${SOCIAL.NAME}`}
                  >
                    {SOCIAL.NAME}
                  </Link>
                  {"/"}
                </li>
              ))
            }
            <li class="line-clamp-1">
              <Link
                href={`mailto:${SITE.EMAIL}`}
                aria-label={`Email ${SITE.TITLE}`}
              >
                {SITE.EMAIL}
              </Link>
            </li>
          </ul>
        </section>
      </div>
    </aside>
  </Container>
</Layout>
