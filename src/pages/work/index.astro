---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { dateRange, duration } from "@lib/utils";
import { WORK } from "@consts";

const work = (await getCollection("work")).sort(
  (a, b) => b.data.dateStart.valueOf() - a.data.dateStart.valueOf(),
);
---

<Layout title={WORK.TITLE} description={WORK.DESCRIPTION}>
  <Container>
    <aside data-pagefind-ignore>
      <div class="space-y-10">
        <div
          class="animate flex flex-wrap items-center justify-between gap-y-2"
        >
          <div class="font-semibold text-black dark:text-white">Work</div>
          <Link
            href="/resume.pdf"
            download="김지욱_이력서.pdf"
            data-track="work-resume-download">이력서 PDF 받기</Link
          >
        </div>
        <ul class="flex flex-col space-y-10">
          {
            work.map((entry) => (
              <li class="animate space-y-3">
                <div class="space-y-1">
                  <div class="font-semibold text-black dark:text-white">
                    {entry.data.company}
                  </div>
                  <div class="text-sm opacity-75">{entry.data.role}</div>
                  <div class="text-sm opacity-75">
                    {dateRange(entry.data.dateStart, entry.data.dateEnd)}
                    {duration(entry.data.dateStart, entry.data.dateEnd) && (
                      <span>
                        {" · "}
                        {duration(entry.data.dateStart, entry.data.dateEnd)}
                      </span>
                    )}
                    {" · "}
                    {entry.data.summary}
                  </div>
                </div>
                {entry.data.highlights && (
                  <ul class="list-disc space-y-1 pl-5 text-sm">
                    {entry.data.highlights.map((highlight) => (
                      <li>{highlight}</li>
                    ))}
                  </ul>
                )}
                <ul class="flex flex-wrap gap-x-2 gap-y-1 text-xs opacity-75">
                  {entry.data.stack.map((tech) => (
                    <li class="rounded border border-black/10 px-2 py-0.5 dark:border-white/15">
                      {tech}
                    </li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ul>
      </div>
    </aside>
  </Container>
</Layout>
